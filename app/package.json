{
  "name": "delulu",
  "version": "0.0.0",
  "private": true,
  "description": "Session handoff and resume for Claude Code.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync": "node scripts/sync-cache.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "corpus": "esbuild src/cli/corpus-check.ts --bundle --platform=node --format=esm --target=node22 --log-level=warning --outfile=node_modules/.cache/delulu/corpus-check.mjs && node node_modules/.cache/delulu/corpus-check.mjs",
    "dev": "node scripts/build.mjs && node scripts/sync-cache.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "knip": "^6.16.1",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}
