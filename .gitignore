# Dependencies and build output (node_modules has no trailing slash, so a symlinked one matches too)
node_modules
dist/
vitest.config.ts.timestamp-*.mjs

# Logs and OS files
*.log
.DS_Store
Thumbs.db

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
secrets.json
**/*.secret.*

# Editors
.idea/
.vscode/
*.swp

# Temp files
*.tmp
*.tmp.*

# Local Claude Code settings and delulu's own handoffs
.claude/settings.local.json
.claude/settings.local.json.*
.delulu-handoff/

# Claude Code's per-machine state (.claude/commands/ and .claude/agents/ stay trackable)
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/routines/.state/
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock
.claude/agent-registry.json
.claude/agent-memory-local
.claude/first-run
.claude/assistant-daemon-state.json
